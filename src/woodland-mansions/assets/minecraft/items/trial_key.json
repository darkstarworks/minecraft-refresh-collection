{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:item_name",
    "cases": [
      {
        "when": "Stronghold Key",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/stronghold_key"
        }
      },
       {
        "when": "Mansion Key",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/mansion_key"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/trial_key"
    }
  }
}